        <options>B</options>
      </impliedOptions>
      <excludedOptions></excludedOptions>
      <defaultValue>Selected</defaultValue>
      <optional>True</optional>
    </configurationOption>

    <!-- B (optional) -->
    <configurationOption>
      <name>B</name>
      <outputString>B</outputString>
      <prefix></prefix>
      <postfix></postfix>
      <parent>root</parent>
      <children></children>
      <impliedOptions></impliedOptions>
      <excludedOptions></excludedOptions>
      <defaultValue>Selected</defaultValue>
      <optional>True</optional>
    </configurationOption>

    <!-- C (optional) -->
    <configurationOption>
      <name>C</name>
      <outputString>C</outputString>
      <prefix></prefix>
      <postfix></postfix>
      <parent>root</parent>
      <children></children>
      <impliedOptions></impliedOptions>
      <excludedOptions></excludedOptions>
      <defaultValue>Selected</defaultValue>
      <optional>True</optional>
